<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:id="@+id/w_streak" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFC21A" android:textSize="22sp" android:textStyle="bold" android:text="Day one" />
    <TextView android:id="@+id/w_today" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#FFFFFFFF" android:textSize="14sp" android:text="System design ○  DSA ○" />
    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#FFBCC1E0" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:text="Open DataLeap to set up" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_days" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFBCC1E0" android:textSize="12sp" android:text="" />
        <TextView android:id="@+id/w_start" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_btn" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:textColor="#FF0F1235" android:textSize="13sp" android:textStyle="bold" android:text="Start" />
    </LinearLayout>
</LinearLayout>
